!% -~S                      ! compiler option: strict mode off (smaller, faster story file)
!% $OMIT_UNUSED_ROUTINES=1   ! compiler setting: strip routines that are never called

! ============================================================================
!  HAUNTED HOUSE  —  frotzsmith sample (PunyInform)
! ----------------------------------------------------------------------------
!  Based on Radio Shack's 1979 text adventure "Haunted House" for the TRS-80
!  (Tandy Model I / III) — reverse-engineered from the original and reimplemented
!  in Inform 6, then converted to PunyInform.
!
!  A *partial* conversion: the first floor of the mansion. Converting from the
!  Standard Library to PunyInform meant dropping a few std-only constructs (the
!  LibraryMessages object, the Compass-based exit lister, the z5+ ClearScreen),
!  which is why this version is lean enough to target .z3 — PunyInform's reason
!  for being. It compiles AND plays at z3 (255-object / 128 KB limits).
!
!  WHAT THIS SAMPLE TEACHES
!    How a whole small game hangs together, rather than one idea at a time:
!    classes that share behaviour, puzzles that depend on each other, exits
!    written as routines, a door shared by two rooms, a score, magic words,
!    and new verbs added with Verb and Extend.
!
!  HOW THE GAME FLOWS  (the walkthrough, in order)
!    1. Outside the house you cannot move, and the front door is stuck. The
!       crumpled paper here says "Magic word - PLUGH".
!    2. PLUGH teleports you into the Foyer (1 point). SAY PLUGH works too.
!    3. The Living Room (east) has a knife floating out of reach and a
!       scroll on the floor. TAKE SCROLL first: the knife comes within reach,
!       and TAKE KNIFE (1 point). Anything else done to the knife while it
!       floats kills you; once you hold it, it is an ordinary knife.
!    4. In the Kitchen (Foyer, south, east) a suit of armour blocks the way
!       south until you carry the knife; then it flees.
!    5. Through the Breakfast Room, east, then north: the second Servant's
!       Quarters, where a cabinet holds a small key.
!    6. Back west through the Den to the Foyer, then west twice to the West
!       End of Hall. UNLOCK DOOR WITH KEY opens the hall door; SOUTH is the
!       Master Bedroom, where a raging fire blocks the way on.
!    That is the end of the first floor. The rest of the house, and the
!    ESCAPE the scroll promises, is not written yet; 2 of the 4 points can
!    be earned so far.
!
!  TWO CHEAT COMMANDS, ON PURPOSE
!    This sample doubles as a demo of putting cheat / debug commands straight
!    into a game. GO <room> jumps to any room you have not visited yet, and
!    ZAP <room> to any room at all. See "CHEAT COMMANDS" at the end of the
!    file for exactly how they work and why an author adds them.
!
!  A NOTE ON STYLE
!    The name properties here use double quotes ("name" "tag"), an older
!    habit Inform still accepts there; the other samples use the modern
!    single quotes ('name' 'tag'). Both give dictionary words.
!    The layout is also looser than the other samples (uneven indentation,
!    blank lines inside routines, a comma after some rooms' short names):
!    the compiler ignores spacing and accepts those commas, so the file is
!    kept close to how it was first written.
!
!  HOW THIS FILE IS BUILT  (top to bottom)
!    1. The two `!%` compiler-option lines (they must be first).
!    2. Game identity constants, then Include "globals.h" and "puny.h".
!    3. Three classes: Room, Scenic, Furniture.
!    4. Limbo, the name tag, then the rooms and their objects in map order:
!       Outside, Foyer, Living Room, Dining Room, Den, Kitchen, Breakfast
!       Room, the two Servant's Quarters, East and West End of Hall, Master
!       Bedroom.
!    5. The Initialise entry point.
!    6. New verbs and Extends (they need the library's grammar first, which
!       puny.h has already included): EXIT, the magic words, and the GO /
!       ZAP cheat commands.
!
!  MAP OF THE FIRST FLOOR
!
!     West End --- East End --- Foyer --- Living Room --- Dining Room
!     of Hall      of Hall        |                            |
!        |                       Den ----------------------- Kitchen
!    (hall door)                                               | (armour)
!        |                                              Breakfast Room
!     Master Bedroom                                           |  (east)
!     (fire to the south)        Servant's Qtrs 2 --- Servant's Qtrs 1
!                                   (cabinet + key)   (empty cabinet)
!    (Servant's Quarters 2 is NORTH of Servant's Quarters 1; the picture
!    lays them side by side to fit.)
!
!    Exits, exactly as the code has them:
!      Foyer: S Den, W East End, E Living Room
!      Living Room: W Foyer, E Dining Room      Dining Room: W Living, S Kitchen
!      Den: N Foyer, E Kitchen                  Kitchen: N Dining, W Den,
!                                                        S Breakfast (armour)
!      Breakfast Room: N Kitchen, W Den, E Servant's Quarters 1
!      Servant's Quarters 1: W Breakfast, N Servant's Quarters 2
!      Servant's Quarters 2: S Servant's Quarters 1
!      East End of Hall: W West End, E Foyer
!      West End of Hall: E East End, S Master Bedroom (through the hall door)
!      Master Bedroom: N West End (through the door); S is blocked by fire
!    (Breakfast Room W leads to the Den, but the Den has no way back east to
!    the Breakfast Room: exits are one-way unless both rooms list them.)
!
!  PUZZLE CHAIN (each step needs the one before)
!    paper (read it) -> PLUGH -> scroll -> knife -> armour flees ->
!    servants' quarters -> cabinet -> small key -> hall door -> bedroom
!
!  STATE: what remembers progress, who changes it, who reads it
!    score                 +1 PLUGH outside; +1 taking the knife; -1 dropping
!                          it in the Living Room. Read by SCORE.
!    knife's parent        living_room = floating; player = held. Read by
!                          the knife's before/describe, kitchen.s_to.
!    scroll's parent       player once taken; read by the knife's Take rule.
!    kitchen.armor_fled    0 -> 1 the first time you go south with the knife.
!    hall_door locked/open cleared/set by UNLOCK (after rule opens it too);
!                          read by both rooms' exit routines and describe.
!    visited (attribute)   set by the library on each room you see; read by
!                          the foyer's initial and the GO cheat.
!    deadflag              1 when the floating knife kills you.
!
!  CONSTRUCTS YOU MEET HERE FOR THE FIRST TIME (if you read the small samples)
!    Class, MAX_SCORE/score, cant_go, initial, describe, found_in,
!    door_dir/door_to, a direction property that is a routine, custom
!    properties holding numbers and routines, deadflag, lookmode, setting
!    `location` in Initialise, Extend ... first, <<Action noun>>, scope
!    routines, PlayerTo, and commented-out code kept for later.
!    Each is explained where it first appears below.
!
!  WHAT CHANGED IN THE CONVERSION TO PUNYINFORM  (compare haunted-house.inf)
!    Dropped, because PunyInform has no equivalent or the game is z3:
!      • LibraryMessages. PunyInform customises messages differently (by
!        defining MSG_... constants before globals.h). So the game's own
!        replies to BUY / PRAY / SING / SLEEP / SORRY are gone — and those
!        verbs themselves are only in PunyInform's optional extended verb
!        set (Constant OPTIONAL_EXTENDED_VERBSET;), so here they are "not a
!        verb I recognize".
!      • The DIRS / EXITS verb and frotzsmith's Exits.h: both walk the
!        Standard Library's Compass objects, which PunyInform doesn't have.
!      • ClearScreen(WIN_MAIN) before the PLUGH teleport.
!      • DeathMessage (it was only a placeholder).
!    Rewritten:
!      • The Master Bedroom's fire: a room `before` rule on Go became a
!        plain s_to routine that prints and stays put (it compares no
!        compass object, which keeps it library-neutral).
!      • The scope routines' "not allowed" message: a literal string
!        instead of the Standard Library's L__M(##Go, 2).
!      • Initialise sets `location` itself (PunyInform also accepts that,
!        instead of Constant INITIAL_LOCATION_VALUE).
!    Behaves differently without any code change (verified in play):
!      • EXAMINE HOUSE outside: PunyInform's own "You don't need to refer
!        to "house" in this game." (the Std version overrode this).
!      • OUT is a compass direction here ("A mysterious force keeps you
!        planted in place."); LEAVE is the synonym that reaches EXIT.
!      • ANSWER and SPEAK share their grammar with SAY, so ANSWER PLUGH
!        works like SAY PLUGH.
!      • GO is the only "go" verb (no RUN or WALK).
!      • `lookmode = 2` in Initialise really matters here: PunyInform
!        starts in BRIEF mode (1), the Standard Library already in VERBOSE.
!    Everything else — classes, the puzzles, the door, the cheats — is the
!    same code in both libraries.
! ============================================================================

! --- Game identity ------------------------------------------------------------
! `Constant` names a value fixed at compile time. Story is the title and
! Headline the subtitle, both printed in the opening banner (^ is a newline).
! MAX_SCORE is the score the game is out of: the library prints it in the
! SCORE reply ("1 out of a possible 4"). The `=` in `Constant MAX_SCORE = 4`
! is optional; `Constant MAX_SCORE 4;` means the same.
! MAX_SCORE must be defined BEFORE Include "globals.h": globals.h gives it
! a default of 0 if it doesn't exist yet, and defining it after that is a
! compile error.
Constant Story      "Haunted House";
Constant Headline   "^A port of Radio Shack's Model I/III adventure (circa 1979) written in Inform 6^";
Constant MAX_SCORE     = 4;          ! highest score attainable (shown by SCORE)
Include "globals.h";                 ! PunyInform: global variables & config (before puny.h)



! puny.h: the rest of PunyInform. The classes and objects of the game come
! after it.
! globals.h declares the variables (location, score, lookmode ...), the
! attributes (light, visited, static ...) and the properties (before,
! initial, found_in ...); puny.h brings the parser, the standard actions
! and PunyInform's grammar.h. So there is no "Grammar" include later on,
! and the Verb/Extend lines near the end can come straight after the
! objects. (The two `!%` lines at the top are compiler switches: strict
! mode off for a smaller story, and unused routines left out — which
! matters here, since this game targets z3, the smallest format.)
Include "puny.h";

! ============================================================================ !
! Classes
! ============================================================================ !

! A CLASS is a template for objects. `Class Room` lists properties (`with`)
! and attributes (`has`) once; every object declared as a Room gets them.
! A Room is a lit location. Every room in the house is one, so `has light`
! is written once here instead of on every room. The empty before/after
! routines are hooks: a room adds its own by giving the property again.
! `before` and `after` are "additive" library properties: a room's own
! routine does not replace the class's, it runs FIRST, and the class's
! runs after it only if the room's returned false. (For an ordinary
! property such as `description`, the object's value simply replaces the
! class's.) These empty routines do nothing and return false.
! To make an object of a class, use the class name in place of `Object`:
!   Room kitchen "The Kitchen" with ... ;
! A class also lets code ask `if (obj ofclass Room)`, which the GO/ZAP
! cheat commands at the end of the file use to find every room.
Class Room
with before [;
            
         
    ],
    after [;],
    has     light;

! Scenic: a thing that is only part of the scenery (here, the fire). EXAMINE
! works as usual (`return false` lets the library carry on), and any other
! action gets one polite refusal, so the player is not tempted to fiddle.
! `default:` in a before routine catches every action not named above it.
! `(the) self` inside print_ret is a PRINT RULE: it prints the object's
! short name with "the" in front ("the raging fire"); `(The)` capitalises.
! `has scenery`: the object is not listed in the room description (the
! room text mentions it instead) and cannot be taken.
Class Scenic
    with before [;
            Examine: return false;
            default:
                print_ret "You don't need to worry about ", (the) self, ".";
    ],
    has scenery;


! Furniture: heavy things you can put things on but not carry. Taking,
! pulling or pushing it gets one message; `static supporter` does the rest.
! `Take,Pull,Push,PushDir:` — one block for four actions (PushDir is PUSH
! CABINET NORTH). `static` = fixed in place; `supporter` = things can be
! put ON it (PUT KEY ON CABINET).
Class Furniture
    with before [;
        Take,Pull,Push,PushDir:
            print_ret (The) self, " is too heavy for that.";
    ],
    has static supporter;

! ============================================================================ !
! Limbo
! ============================================================================ !

! Limbo is an off-stage room: a place to move objects that have left play.
! (The unfinished bucket-of-water puzzle below used it.) The player never
! goes there, hence the joke description.
! It is declared with `Object`, not `Room`, so it is not part of the Room
! class: no light, and the GO/ZAP cheat commands can't reach it.
! (`remove obj;` is the other way to take an object out of play: it then
! has no parent at all.)
Object  limbo "Limbo"
    with  description "How the hell did you get in here?";


! ============================================================================ !
! Initial inventory
! ============================================================================ !

! The name tag the player wears from the start (Initialise moves it to the
! player). Its before routine answers every action itself, so it can never
! be dropped or used: it is there for character, not for a puzzle.
! It is declared with no parent (no arrow, no room name), so it starts
! nowhere until Initialise runs `move nametag to player;`.
! Note the order inside `with`: description, before, then name. The order
! of properties in an object doesn't matter. The library only asks the
! tag's before routine when the tag is the noun of the action, so
! INVENTORY still lists it normally.
! (The tag's Examine answer means its own `description` is never printed.)
Object nametag "name tag"
    with description "A small tag with your name on it.",
    before [;
        Drop:
            print_ret "You can't drop your name tag. No one will know who you are!";
        Examine:
            print_ret "It's a small tag with your name on it.";
        default:
            print_ret "You can't do that with your name tag.";
    ],
    name "name" "tag" "small";



! ============================================================================ !
! Outside the House
! ============================================================================ !

! The starting location. There are no exits at all: cant_go is the message
! for every direction the player tries. The only way in is the magic word
! (PlughSub, near the end of the file).
! `Room outside_house "Outside the house"` declares an object of class Room
! (lit, with the class's empty before/after). `cant_go` is a library
! property: what GO prints instead of "You can't go that way." The `name`
! words on a room do not make it something the player can handle: PunyInform
! answers EXAMINE HOUSE with "You don't need to refer to "house" in this
! game." The GO/ZAP cheats use these words to name rooms.
Room    outside_house  "Outside the house"
    with    description "You are at the outside of the house. The front door is closed.", 
     name    "house" "outside",
     cant_go "A mysterious force keeps you planted in place.";
    

! The hint for the magic word. It can only be read while held: its before
! routine checks the paper's parent (who has it) for EXAMINE and READ.
! In PunyInform (as in the Standard Library), READ PAPER is the Examine
! action; Consult is READ ABOUT <something> IN PAPER, so both are caught.
! Its `description` property is left empty, since before always
! answers first. (A property named with no value gets 0.)
! `Object crumpled_paper "..." outside_house` names its parent room
! directly instead of using an arrow. `parent(x)` is the object that
! contains x; `==` compares. A takeable object needs no attributes.
! The `;` that ends this object sits alone on the last line.
Object   crumpled_paper "crumpled piece of paper" outside_house
    with    description,
            before [;
                Consult,Examine:
                    if (parent(crumpled_paper)==player) {
                        print_ret "It says, 'Magic word - PLUGH.'";
                         }
                    else {
                        print_ret "You're not carrying it.";
                    }     
    ],
    name    'paper' 'crumpled' 'piece'
;

! The front door is a dead end on purpose: it is locked and its before
! routine says it is stuck, so the player has to look for another way in.
! `has door locked static scenery`: `door` marks it as a door (a thing that
! connects rooms), `locked` marks it locked (the before rule answers OPEN
! anyway, and UNLOCK fails because it is not `lockable`), `static` and
! `scenery` keep it fixed and out of the room listing. It has no door_to,
! because no exit leads through it: outside_house has no exits at all.
Object front_door "front door" outside_house
    with    description "The front door.",
    
     before [;
                Consult,Examine:
                        print_ret "It is closed.";
                Open:
                    print_ret "You give it a push. It's stuck.";
                
                    
                
                    
    ],
    name "door" "front",
    has door locked static scenery;



! ============================================================================ !
! The Foyer
! ============================================================================ !

! The Foyer, where PLUGH lands you. Its `initial` routine runs when the
! player arrives; `self hasnt visited` is true only on the first arrival,
! so the materialising message is printed once. `rfalse` prints nothing.
! For a ROOM, `initial` runs on arrival just before the room description.
! `visited` is an attribute the library gives a room once the player has
! seen it lit; it is still unset while this first `initial` runs.
! `rfalse` = "return false"; `rtrue` = "return true". Here the value is not
! used for anything; rfalse just ends the routine quietly.
! Exits: s_to, w_to, e_to name the rooms in those directions. The
! routine's closing `]` and the property list's `,` share a line: `}],`.
Room foyer "The Foyer"
with description "You are in the foyer.",
initial [;
    if (self hasnt visited) {
         "^** You feel a vibration all around. Your surroundings blur. Suddenly, you materialize inside the house. **";
     } else {
        rfalse;
     }],
name "foyer",
s_to den,
w_to east_end_of_hall,
e_to living_room;

! ============================================================================ !
! The Living Room
! ============================================================================ !

! The Living Room: the knife-and-scroll puzzle. The room itself is plain;
! the puzzle lives in the knife and scroll objects below.
Room living_room "The Living Room"
with description "You are in the living room.",

name "living",
w_to foyer,
e_to dining_room;

! The levitating knife. Its before routine is the whole puzzle:
!   Take    -- only once the scroll is held and the knife is still floating
!              here. Then it is yours, and worth a point. A knife dropped
!              in any other room lies on the floor, and the library takes
!              it as it would any object.
!   Drop    -- dropping it here sets it floating again, and the point goes.
!   default -- while it FLOATS (its parent is the Living Room), any other
!              action aimed at it (examine, push...) is fatal: deadflag = 1
!              is the library's "you have died". Once you hold it, those
!              actions are harmless and get the library's normal replies.
! `describe` replaces the library's "You can see a knife here" line in the
! room description: floating while it is in the room, plain otherwise.
!
! New ideas here:
!   `self in player`     — `in` tests "is directly inside": true when the
!                           player is holding it.
!   `~=`                 — "is not equal to".
!   `move self to player` — the knife goes into the player's inventory
!                           without the library's Take (so no "Taken.").
!   `score = score + 1;` — `score` is the library's score variable. After
!                           the turn the library notices the change and
!                           prints "[The score has just gone up by 1
!                           point.]".
!   `deadflag = 1;`      — the library's "game over" switch. At the end of
!                           the turn it prints "*** You have died ***" and
!                           offers RESTART / RESTORE / QUIT. PunyInform
!                           names the values: GS_DEAD = 1, GS_WIN = 2, and
!                           GS_DEATHMESSAGE = 3 (print your own
!                           DeathMessage; this version defines none).
!   `rfalse`             — "not handled": the library carries on as if
!                           there were no before rule.
! The Drop block has no `else`: dropping the knife anywhere but the Living
! Room reaches the end of the block, the routine returns false, and the
! library drops it normally. Blocks never fall through into the next label.
! `describe` returns true (bare strings), so the library prints nothing
! more for the knife. `else "..."` after an `if` is fine on one line.
Object knife "knife" living_room
with description "A knife.",
before [; 

    Take:
        if (self in player) rfalse;   ! already held: the library says so
        if (parent(self) ~= living_room) rfalse;   ! dropped elsewhere: an ordinary knife
        if (parent(scroll)==player && parent(knife)==living_room) {
            move self to player;
             score = score + 1;
            print_ret "You reach out and snatch the knife from the air.";
           
        } else {
            print_ret "The knife moves just out of your reach.";
        }

    Drop:
        if (player in living_room) {
            move self to living_room;
            score = score - 1;
            print_ret "^You drop the knife. It shakes, quivers, then slowly levitates a few feet above the floor.";
        }

    default:
        ! Only the FLOATING knife is deadly. Once you hold it (or it lies
        ! anywhere but here), other actions get the library's usual replies.
        if (parent(knife) ~= living_room) rfalse;
        deadflag = 1;
        "^Suddenly the knife swoops down and slits your throat.";
    
],
describe [;
            if (parent(knife)==living_room) "^A knife is levitating in the middle of the room.";
            else "^There is a knife here.";
        ],
name "knife" "levitating";


! The scroll: taking it is what brings the knife within reach. It can only
! be read while held (the parent check again). Both `initial` and `describe`
! give its line in the room description.
! When an object has both, the library tries `describe` first; since this
! describe always prints and returns true, the `initial` routine is never
! actually used. (`initial`, on a thing, is the line printed while the
! thing has not yet been moved; `describe` is used every time.)
! The Take rule moves the scroll itself (so the library's "Taken." is
! written by hand) only while the knife floats. Once the knife has been
! taken, the condition fails, the block ends, and the library's own Take
! runs. `Consult,Examine:` answers READ / EXAMINE / LOOK UP ... IN SCROLL.
Object scroll "mysterious scroll" living_room
with description,
initial [; "^There is a mysterious scroll on the ground.";],
before [;
                 Take:
                    if (parent(knife)==living_room) {
                        move self to player;
                        print_ret "Taken. ^^The levitating knife zooms down and moves within your reach.";
                    }

                Consult,Examine:
                    if (parent(scroll)==player) {
                        print_ret "It says, 'There is ESCAPE from the second floor!'";
                    }
                    else {
                         print_ret "You're not carrying it.";
                    }
                       
                
    ],
describe [;
            "^There is a mysterious scroll on the ground.";
        ],
name "scroll" "mysterious";

! ============================================================================ !
! The Dining Room
! ============================================================================ !

! Rooms with nothing in them yet, part of the map for the full game.
! Note the comma after the short name ("The Dining Room",): the compiler
! accepts a comma there, and it changes nothing.
Room dining_room "The Dining Room",
with description "You are in the dining room.",
name "dining",
w_to living_room,
s_to kitchen;

! ============================================================================ !
! Den
! ============================================================================ !

Room den "The Den",
with description "You are in the den.",
name "den",
n_to foyer,
e_to kitchen;

! ============================================================================ !
! Kitchen
! ============================================================================ !

! The Kitchen. Its south exit is a routine instead of a room: it runs when
! the player goes south, and either returns the room to move to or prints a
! refusal and returns true (print_ret), which keeps the player here.
! The rule for a direction routine: return a room to go there; return
! true (1) to stay put having printed something; return false (0) for the
! library's "You can't go that way."
! `armor_fled 0,` is a CUSTOM PROPERTY: a name the library doesn't know,
! which Inform creates for this object, holding a number. `self.armor_fled`
! reads it and `self.armor_fled = 1;` changes it.
! `print` (not print_ret) prints without returning, so the flee message
! is followed by `return breakfast_room;` and the move goes ahead.
! `else if` chains several tests; only the first true branch runs.
!   - Carrying the knife the first time: the armour flees (armor_fled is a
!     property used as this room's own memory of that), and you go south.
!   - Not carrying the knife: the armour blocks you.
!   - Carrying it after that: straight through.
Room kitchen "The Kitchen",
with description "You are in the kitchen.",
name "kitchen",
n_to dining_room,
w_to den,
armor_fled 0,
s_to [;
    if (parent(knife)==player && self.armor_fled == 0) {
        print "^ ** A suit of armor flees when it spots your knife! **";
        self.armor_fled = 1;
        return breakfast_room;
    } else if (parent(knife)~=player) {
        print_ret "^ ** An animated suit of armor blocks your way!  **";
    } else {
       return breakfast_room;
    }
    ];


! KEPT FOR LATER: the block below is a whole object "commented out" — each
! line starts with `!`, so the compiler skips it. The author kept this
! unfinished poisoned-water puzzle in the file to finish later. It shows
! two things worth knowing: an action can be started from code with
! `<Take bucket_of_water>;` (single angle brackets: do the action, then
! carry on), and ThrowAt is the action for THROW X AT Y.
! Object bucket_of_water "bucket of water" kitchen
!   with name "bucket" "water",
!        description "It's a bucket of water.",
!        before [; 
           
!            ThrowAt:
!                 if (parent(bucket_of_water)==player && player in master_bedroom) {
!                     move bucket_of_water to limbo;
                    
!                     print_ret "Thrown. ^The bucket and water disappear into the fire. ^Suddenly, you feel a mysterious force pull the empty bucket from your hands. It, too, disappears into the fire. ^But to no effect. The fire grows hotter.";
!                 }
!             Drink:
!                 if (parent(bucket_of_water)==player) {
!                      deadflag = 1;
!                     print_ret "You feel sick. The water was poison!";
                   
!                 }

!                 if (parent(bucket_of_water)==kitchen && player in kitchen) {
!                     <Take bucket_of_water>;
!                     deadflag = 1;
!                     print_ret "^You feel sick. The water was poison!";
                    
!                 }
!        ]
!  ;

! A bucket, with the water inside it (`has container open`). The rest of a
! puzzle that used it is the commented-out bucket_of_water above. The
! getBucketStatus property is a small helper routine: " of water" while
! the water is still in it, nothing once it is not, so `initial` and
! `description` always describe it correctly.
! A routine stored in a property is called like a function:
! `self.getBucketStatus()`. It RETURNS a string here instead of printing
! it, and `(string)` in the print list prints that returned string.
! `child(bucket)` is the first object inside the bucket (or nothing).
! A bare-string statement can list several items separated by commas:
!   "There is a bucket", (string) self.getBucketStatus(), " here.";
! prints them in order, then a newline, then returns true.
! `container open`: things can be inside, and the inside is visible.
! (`initial` is used while the bucket has not been moved; once taken and
! dropped, the library's own "You can see a bucket here" line is used.)
Object bucket "bucket" kitchen
  with name "bucket" "pail",
  getBucketStatus [;
           if (child(bucket) == water) return " of water";
           return "";
        ],
  initial [;
        "There is a bucket", (string) self.getBucketStatus()," here.";],
    description [;
        "It's a bucket", (string) self.getBucketStatus(),".";],
    has container open;


! The water starts inside the bucket. article "some" makes the library say
! "some water", not "a water".
! It names its parent (`bucket`) after the short name. It has no puzzle
! role in this first-floor version.
Object water "water" bucket
    with name "water" "liquid",
    article "some",
    description "Looks like water to me."
    ;





! ============================================================================ !
! Breakfast Room
! ============================================================================ !

! Beyond the armour. East leads to the servants' quarters.
! (West leads to the Den, but the Den has no east exit back here: the Den's
! e_to is the Kitchen.)
Room breakfast_room "The Breakfast Room",
with description "You are in the breakfast room.",
name "breakfast",

n_to kitchen,
w_to den,
e_to servants_quarters_1;



! ============================================================================ !
! Servant's Quarters 1
! ============================================================================ !

! Two rooms share the printed name "The Servant's Quarters", so each also
! has its own name word (serv1, serv2) for the parser and for GO / ZAP.
Room servants_quarters_1 "The Servant's Quarters",
with description "You are in the servant's quarters.",
name "servants" "quarters" "serv1",
w_to breakfast_room ,
n_to servants_quarters_2;

! An empty cabinet: a red herring next to the real one. It is Furniture (it
! will not move) as well as a container you can open.
! `Furniture cabinet_empty "cabinet" servants_quarters_1` uses the class
! name as the declaration keyword. The object gets the class's before rule
! (Take/Pull/Push refused) and its `static supporter` attributes, PLUS its
! own `container openable`. Being both a container and a supporter is
! unusual but allowed. No `open` attribute, so it starts closed.
! There is no comma between the description and `has`: the compiler
! accepts the `has` part without one.
Furniture cabinet_empty "cabinet" servants_quarters_1
  with name "cabinet" "cabinet1",
       description "There is a cabinet on one wall."
  has  container openable;


! ============================================================================ !
! Servant's Quarters 2
! ============================================================================ !

Room servants_quarters_2 "The Servant's Quarters",
with description "You are in the servant's quarters.",
name "servants" "quarters" "serv2",
s_to servants_quarters_1;

! The cabinet that matters: OPEN CABINET shows the small key inside it
! ("You open the cabinet, revealing a small key."). It is a plain Object,
! not Furniture, so TAKE CABINET would actually work here.
! The two cabinets are told apart by their extra name words, cabinet1 and
! cabinet2, and by being in different rooms.
Object cabinet_with_key "cabinet" servants_quarters_2
  with name "cabinet" "cabinet2",
       description "There is a cabinet on one wall."
  has  container openable;

! The key to the hall door (the door's with_key names it). It starts
! inside the closed cabinet, so it can't be seen until the cabinet opens.
Object hall_door_key "small key" cabinet_with_key
  with name "small" "key",
       description "It's a small key."
  ;


! ============================================================================ !
! East End of Hall
! ============================================================================ !

Room east_end_of_hall "East End of Hall",
with description "You are at the east end of the hall.",
name "east" "hall", 
w_to west_end_of_hall,
e_to foyer;

! ============================================================================ !
! West End of Hall
! ============================================================================ !

! The West End of Hall. Its south exit is a routine that checks the hall
! door: locked, closed, or open (then it returns the bedroom to move to).
! `has` / `hasnt` test an attribute of another object (hall_door) just as
! they test `self`.
Room west_end_of_hall "West End of Hall",
with description "You are at the west end of the hall.",
name "west" "hall",
s_to [; 
    if (hall_door has locked) {
        print_ret "You need to unlock the door first.";}
    else if (hall_door hasnt open) {
        print_ret "The door is closed.";
    } else {
        return master_bedroom;
    }],
e_to east_end_of_hall;

! The hall door between the West End of Hall and the Master Bedroom.
! found_in puts one door in BOTH rooms. door_dir and door_to are the
! library's door properties (which way the door faces, where it leads),
! worked out from where the player stands; the rooms' own exit routines do
! the actual moving. describe gives the door's line in each room for each
! state. after Unlock: unlocking also opens it, so one command does both.
! `static door openable lockable locked`: fixed in place, a door, can be
! opened, can be locked, and starts locked.
!
! In more detail:
!   `Object -> hall_door` — the arrow would put the door inside the most
!       recent arrow-less object (the West End of Hall), but `found_in`
!       takes over: the library moves the door into whichever listed room
!       the player is in, so it appears in both.
!   door_dir — a routine returning a DIRECTION PROPERTY (n_to, s_to). The
!       library uses it for ENTER DOOR / GO THROUGH DOOR, turning it into
!       GO SOUTH (or NORTH), which then runs that room's exit routine.
!   door_to — where the door leads. The library would use it if an exit
!       property named the door itself (`s_to hall_door`). Here the exits
!       are routines, so door_to is there for completeness.
!   getDoorDirection — a custom routine property returning the word
!       "north" or "south" for describe's message.
!   describe — three states, three lines: open; unlocked but shut; locked.
!   after Unlock — `after` runs once the library's action has succeeded
!       (the door is unlocked). It gives the door `open` and then ends
!       without returning true, so the library still prints its own
!       "You unlock the hall door."
!   with_key hall_door_key — only that key unlocks it.
Object  -> hall_door "hall door"
  with  name "hall" "door",
        description "It's a door.",
        with_key hall_door_key,
        door_dir [;
            if (location == master_bedroom) return n_to;
            return s_to;
        ],
        door_to [;
            if (location == master_bedroom) return west_end_of_hall;
            return master_bedroom;
        ],
        getDoorDirection [;
           if (location == master_bedroom) return "north";
           return "south";
        ],
        describe [;
            if (self has open) "^A door to the ", (string) self.getDoorDirection(), " is open.";
            if (self hasnt open && self hasnt locked) "^A door to the ", (string) self.getDoorDirection(), " is unlocked but shut.";
            if (self has locked) "^A door to the ", (string) self.getDoorDirection(), " bars your way.";
            
        ],
         after [;
          Unlock:
            give self open;
         ],
        found_in west_end_of_hall master_bedroom,
  has   static door openable lockable locked;

! ============================================================================ !
! Master Bedroom
! ============================================================================ !

! The Master Bedroom, where the first floor ends: the fire blocks the way
! south. The north exit back to the hall checks the door the same way the
! hall's south exit does.
! The south "exit" is a routine that prints and returns true (print_ret),
! which in both libraries means "don't move, I've said why". The Standard
! Library version does the same job with a room `before` rule that catches
! Go when the noun is the south compass object.
! The final `],` and lone `;` end the object; a trailing comma before the
! `;` is accepted.
Room master_bedroom "Master Bedroom",
with description "You are in the master bedroom.^^A raging fire blocks the door to the south.",
name "master" "bedroom",
! South is the fire: an exit routine that only prints, so you stay put.
s_to [; print_ret "The fire rages, forcing you back."; ],

n_to [; 
    if (hall_door has locked) {
        print_ret "You need to unlock the door first.";}
    else if (hall_door hasnt open) {
        print_ret "The door is closed.";
    } else {
        return west_end_of_hall;
    }],
;

! The fire is Scenic: examine it, but nothing else. TAKE FIRE, for example,
! gets the class's "You don't need to worry about the raging fire."
Scenic fire "raging fire" master_bedroom
with description "The fire is raging. Don't get too close!",
name "fire" "raging"
;



! ============================================================================ !
! Global functions
! ============================================================================ !

! A leftover global version of the door's getDoorDirection property, kept
! commented out (the property on hall_door replaced it).
! [getDoorDirection loc;
!     if (loc == master_bedroom) return "north";
!     if (loc == west_end_of_hall) return "south";
! ];

! ============================================================================ !
! Entry point routines
! ============================================================================ !

! Initialise runs once, before the first turn: the player gets the name tag,
! lookmode 2 means full room descriptions on every visit, and the game
! starts outside the house. The string at the end is printed (and returns
! true) -- the long opening text.
! `lookmode` is a library global; PunyInform starts it at 1 (BRIEF: a room
! you have seen shows only its name), so `lookmode = 2` (VERBOSE) is what
! makes every visit print the full description.
! `location = outside_house;` is the Standard Library way of choosing the
! first room, and PunyInform accepts it too: the library moves the player
! into `location` after Initialise. (The other PunyInform samples use
! Constant INITIAL_LOCATION_VALUE instead; either works.)
! The opening text is one string that runs over several source lines. A
! line break inside a string becomes a single space in the output, so the
! paragraph breaks come only from the `^^` pairs.
[ Initialise; 
    move nametag to player;
    lookmode = 2;
    location = outside_house;
    "^^Generations have passed since the McDaniel family mysteriously disappeared. It is said that a stranger came to visit on that cold, Autumn day many years ago, but no one knows for sure. Their house has been vacant for decades now.
    ^^Its two story image is forlorn and looming, visible only from the narrow, winding road that has been distorted by vegetation from the surrounding forest. The stone wall that encompasses the house is discolored and broken from years of neglect, its iron gate rusty and worn by angry seasons. The windows are boarded and the house is quiet and contented, not accustomed to visitors. The wind is restless today, blowing fallen leaves in all directions.
    ^^As you walk towards the entrance of the house, the wind grows distant and weak. 
    ^^Suddenly, the calm and silence is broken by sounds from within the house!"; ];






! ============================================================================ !
! Verb Updates
! ============================================================================ !

! ------------------------------------------------------------------------------
!   Show doors
! ------------------------------------------------------------------------------




! ------------------------------------------------------------------------------
!   Exit
! ------------------------------------------------------------------------------


! EXIT (and EXIT HOUSE) is the game's goal, so it gets its own answer.
! `Extend 'exit' first` puts these lines before the library's own grammar
! for EXIT, so they are tried first.
! In PunyInform 'exit' and 'leave' are synonyms of ONE verb, and Extend
! changes the verb, not just the word: LEAVE gets this answer too. (OUT is
! a direction here, so it doesn't.) `Extend only 'exit'` would split 'exit'
! off on its own.
! `'house'` in a grammar line is a literal word the player must type.
[ NewExitSub; if (player in outside_house) {
                    "Before you can EXIT the haunted house, you'll need to find a way inside.";
                } else {
                    "Exactly! Your goal is to exit the haunted house.";
                }    ];

Extend 'exit' first
    *              -> NewExit
    * 'house'   -> NewExit;
! ------------------------------------------------------------------------------
!   Magic words
! ------------------------------------------------------------------------------


! Magic words. PLUGH outside the house scores a point and teleports you to
! the Foyer (<<Teleport foyer>> runs the Teleport action and returns);
! anywhere else it says "Sorry, only one PLUGH per customer."
!
! XYZZY is an homage to the classic magic word of Colossal Cave, and it is
! deliberately limited to the game's first room: outside the house, XYZZY
! (or SAY XYZZY) does exactly what PLUGH does; in every other room it is
! just "Nice try.", like the other famous words. XyzzySub makes that choice,
! so the plain and SAY forms always agree.
!   PLUGH, SAY PLUGH                        -> Plugh
!   XYZZY, SAY XYZZY                        -> Xyzzy (Plugh in the first room)
!   SESAME, SHAZAM, FROTZ... (and SAY them) -> OldMagic: "Nice try."
! (Extend 'say' first puts these SAY lines ahead of the library's own.)
!
! `<<Plugh>>` and `<<Teleport foyer>>`: double angle brackets start an
! action from code (here Plugh with no noun; Teleport with noun = foyer)
! and then return true, ending the routine. Single brackets `<Action>;`
! would do the action and carry on.
! (The Standard Library version also clears the screen first with
! ClearScreen(WIN_MAIN); this z3 version leaves that out.)
! In PunyInform 'say' shares its grammar with 'answer' and 'speak', so
! these SAY lines make ANSWER PLUGH and SPEAK XYZZY work too.
! `'sesame'/'shazam'/...` in a grammar line: a slash between words means
! "any one of these".
[ OldMagicSub; "Nice try."; ];
[ XyzzySub;
    if (player in outside_house) <<Plugh>>;   ! the first room only
    "Nice try.";
];
[ PlughSub; 
    if (player in outside_house) {
        score = score + 1;
        <<Teleport foyer>>;
      
        
    } else {
        print_ret "Sorry, only one PLUGH per customer.";
    }
    ];


Verb 'xyzzy'
    *                       -> Xyzzy;
Verb 'plugh'
    *                       -> Plugh;
Verb 'sesame' 'shazam' 'hocus' 'abracadabra' 'foobar' 'open-sesame' 'frotz'
    *                       -> OldMagic;

Extend 'say' first
    * 'xyzzy'               -> Xyzzy
    * 'plugh'               -> Plugh
    * 'sesame'/'shazam'/'hocus'/'abracadabra'/'foobar'/'open-sesame'/'frotz'
                            -> OldMagic;


! ==============================================================================
!   CHEAT COMMANDS  --  deliberate debug shortcuts (start)
! ==============================================================================
!   GO <room>   (also GO TO <room>) jumps straight to any room you have NOT
!               visited yet, by its name word: GO KITCHEN, GO SERV2.
!   ZAP <room>  jumps to ANY room, visited or not: ZAP MASTER.
!   Neither checks exits, doors, darkness or puzzles: the armour, the
!   locked hall door and the fire are all skipped. (PLUGH uses the same
!   Teleport action, but only for its one fixed jump.)
!
!   Why an author adds commands like these: a long game takes a long time
!   to replay. A jump straight to the room you are working on lets you test
!   it now, instead of solving every puzzle before it again after each
!   change. It is also a small, complete example of adding your own verb
!   with a scope routine.
!
!   Before release you would normally remove them, or hide them from
!   players -- for example inside #Ifdef DEBUG; ... #Endif; so they exist
!   only in debug builds (the commented-out #Ifndef lines around ZAP below
!   are a leftover sketch of that). This sample keeps them on purpose.
! ------------------------------------------------------------------------------

! Teleport: the GO <room> and ZAP <room> cheat commands.
! A scope routine decides which objects the parser may match for a token.
! The library calls it in stages: at stage 2 it puts every Room the
! shortcut may reach into scope with PlaceInScope (unvisited rooms for GO,
! all rooms for ZAP); stage 3 prints the message for a room that is not
! allowed.
! The stages, as the Standard Library defines them:
!   (PunyInform calls scope routines with the same three stages.)
!   scope_stage 1 — "may the token match several objects at once?"
!                   rfalse = no, exactly one.
!   scope_stage 2 — put objects in scope. Returning true means "only the
!                   ones I placed"; false would add the normal surroundings.
!   scope_stage 3 — the player named something not in scope: print the
!                   error, here a plain "You can't go there." (The Std
!                   version prints the library's own message instead.)
!                   In play, PunyInform's parser may answer with its
!                   own general message: GO FOYER once you have been
!                   there says "I only understood you as far as "go"
!                   but then you lost me."
! `objectloop (obj ofclass Room)` visits every object of class Room.
! In ZapScope, `obj hasnt visited || obj has visited` is always true (`||`
! is "or"); it reads as "visited or not", i.e. every room.
! The local variable `obj` is declared on the line after the routine name;
! line breaks inside the header don't matter.
[ TeleportScope
    obj;
    switch (scope_stage) {
      1:    rfalse;
      2:    objectloop (obj ofclass Room)
                if (obj hasnt visited) PlaceInScope(obj);
            rtrue;
      3:    "You can't go there.";
    }
];

[ ZapScope
    obj;
    switch (scope_stage) {
      1:    rfalse;
      2:    objectloop (obj ofclass Room)
                if (obj hasnt visited || obj has visited) PlaceInScope(obj);
            rtrue;
      3:    "You can't go there.";
    }
];



! The Teleport action itself: refuse the room you are in, otherwise move
! the player there (PlayerTo also describes the new room).
! `Extend 'go'` (no `first`) adds the lines AFTER the library's GO lines,
! so GO NORTH still means what it always did; only when nothing else
! matches is a room name tried. (In PunyInform 'go' has no synonyms; the
! Standard Library's 'run' and 'walk' are not here.) `scope=TeleportScope` is the token
! that asks the scope routine which objects may match.
! The `#Ifndef DEBUG;` lines around ZAP are commented out, so ZAP is
! always compiled in.
[ TeleportSub;
    if (noun == location) "But you're already here!";
    PlayerTo(noun);
];

Extend 'go'
    * scope=TeleportScope       -> Teleport
    * 'to' scope=TeleportScope  -> Teleport;

! #Ifndef DEBUG;
Verb 'zap'
    * scope=ZapScope       -> Teleport;
! #Endif;

! ==============================================================================
!   CHEAT COMMANDS  (end)
! ==============================================================================


! ============================================================================ 
