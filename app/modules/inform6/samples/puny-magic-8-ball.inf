!% -~S
!% $OMIT_UNUSED_ROUTINES=1

! ============================================================================
!  MAGIC 8-BALL  —  random responses with random() (PunyInform)
! ----------------------------------------------------------------------------
!  Shows: a custom verb (SHAKE), a before handler, and random() driving a
!  switch for varied output.  Try:  SHAKE BALL  (repeatedly).
!  (The Standard Library version is magic-8-ball.inf; the game code is the
!  same, only the library set-up differs.)
!
!  HOW THE GAME FLOWS
!    One room, the Fortune Booth, with a Magic 8-Ball. SHAKE BALL (or ROLL
!    BALL) as often as you like: each shake shows one of six answers, picked at
!    random. SHAKE anything else and nothing happens. No ending.
!
!  KEY CONCEPTS IN THIS FILE
!    • Verb 'word' * noun -> Action;  — teach the parser a brand-new verb
!    • [ ActionSub; ]                — the routine that carries out an action
!    • before [ Action: ... ]        — one object answers the action itself
!    • random(n)                     — a random whole number from 1 to n
!    • switch (value) { 1: ... }     — pick one branch by number
!    • '8//'                         — a one-character dictionary word
!
!  WHAT HAPPENS WHEN THE PLAYER TYPES  SHAKE BALL
!    1. The parser finds 'shake' (our Verb line), matches "ball" to the
!       eightball, and starts the action Shake with noun = eightball.
!    2. The library first runs the eightball's `before` rule. Its Shake:
!       block prints a random answer and returns true: "handled".
!    3. So ShakeSub never runs for the ball. SHAKE ME has no before rule
!       for Shake, so ShakeSub answers that one.
!
!  WHERE THE LIBRARIES' PARSERS DIFFER HERE  (verified in play)
!    SHAKE (no object)  Std: picks the only object, "(the Magic 8-Ball)".
!                       Puny: "I think you wanted to say "shake something".
!                             Please try again."
!    SHAKE TABLE        Std: "You can't see any such thing."
!                       Puny: "Sorry, I don't understand what "table" means."
!                       (The table is only words in the room description.)
! ============================================================================

! ---------------------------------------------------------------------------
! PunyInform COMPILER OPTIONS  (the !% lines that must be first in the file)
!   !% -~S                     — disable strict mode; reduces output file size
!   !% $OMIT_UNUSED_ROUTINES=1 — strip routines unreachable from the game
! These are compiler directives, not ordinary comments.  They only take
! effect as the first lines of the file, so keep them at the top. Switching
! strict mode off is PunyInform's recommended setting; the game would also
! compile with it on (strict mode adds run-time checks for programming
! mistakes, at the cost of size and speed).
! ---------------------------------------------------------------------------

! ---------------------------------------------------------------------------
! STORY METADATA
! `Constant` names a fixed value; PunyInform's banner prints Story (the
! title) and Headline (the subtitle) at startup.
! ---------------------------------------------------------------------------
Constant Story "MAGIC 8-BALL";
Constant Headline "^Random responses with the random() function.^";

! ---------------------------------------------------------------------------
! PunyInform STARTUP — initial location via constant (not in Initialise)
! This constant must be defined BEFORE including globals.h so the library
! can read it at compile time (it becomes the starting value of the global
! `location`). Leave it out and the game still compiles, but the player
! starts in darkness unless Initialise sets `location` itself.
! ---------------------------------------------------------------------------
Constant INITIAL_LOCATION_VALUE = Booth;

! ---------------------------------------------------------------------------
! PunyInform INCLUDES
!   globals.h — global variables, constants, and compile-time configuration
!   puny.h    — full library: parser, actions, AND grammar in one file
! Unlike the Standard Library there is no separate Include "Grammar" at the
! end; puny.h already contains the grammar table.
! ---------------------------------------------------------------------------
Include "globals.h";
Include "puny.h";

! ---------------------------------------------------------------------------
! THE ROOM — permanently lit via `light`
! The small table is only part of the description text, not an object.
! ---------------------------------------------------------------------------
Object Booth "Fortune Booth"
  with description "A velvet-draped booth. A Magic 8-Ball sits on a small table.",
  has  light;           ! `light` → always lit; no lamp required

! ---------------------------------------------------------------------------
! THE MAGIC 8-BALL OBJECT
!
! Placed in Booth via `->` (direct child of the preceding top-level object).
! Its identifier is `eightball` because identifiers can't start with a digit.
!
! `name` gives multiple synonyms so the parser accepts many natural phrasings:
!   SHAKE BALL, SHAKE 8-BALL, SHAKE EIGHTBALL, ROLL BALL, etc.
! No `has` line: a plain object, so TAKE / DROP / EXAMINE work as usual.
! ---------------------------------------------------------------------------
Object -> eightball "Magic 8-Ball"
  ! '8//' is the dictionary word 8. A single character in single quotes,
  ! like '8', is a character constant, not a word, so the // marks it
  ! as a word (the compiler warns about a bare '8' in a name property).
  with name 'magic' '8-ball' 'eight' 'ball' '8//' 'eightball',
       description "A glossy black sphere with a little window in the bottom.",

       ! -----------------------------------------------------------------------
       ! BEFORE HANDLER — Shake action only
       !
       ! `before` is checked BEFORE the library runs the default action for
       ! any command targeting this object.  Printing something (implicitly
       ! returning true) cancels the default.
       !
       ! Only the Shake action is listed here; all other actions (TAKE,
       ! EXAMINE, DROP, …) fall through to the library's default handling.
       !
       ! Inside `before`, use the BASE action name (Shake:), not ShakeSub:.
       ! -----------------------------------------------------------------------
       before [;
           Shake:
               ! `print` emits text without a trailing newline and without
               ! returning — execution continues into the switch statement.
               print "You give the 8-Ball a shake. It reveals: ";

               ! ---------------------------------------------------------------
               ! random(N) — returns an integer in [1..N] with uniform
               ! probability.  Each call is independent, so repeated shakes
               ! genuinely feel random to the player (the same answer can
               ! come up twice running).
               !
               ! switch (expr) { N: body; … }
               !   Evaluates expr once, then runs the body of the matching
               !   integer label.  A bare string literal as a case body acts
               !   as `print_ret`: it prints the string and returns true,
               !   ending the before handler for that turn.
               !   Each case ends at the next label; there is no fall-through
               !   and no `break` is needed. All six possible values have a
               !   label, so the handler always returns true.
               !
               ! TILDE (~) IN STRINGS
               !   In Inform 6 string literals, ~ is an escape for a literal
               !   double-quote character.  "~Yes, definitely.~" prints as:
               !      "Yes, definitely."
               !   (the quotation marks are visible to the player).
               !   Backslash-quote (\") is NOT valid in I6 strings.
               ! ---------------------------------------------------------------
               switch (random(6)) {
                   1: "~It is certain.~";
                   2: "~Reply hazy, try again.~";
                   3: "~Don't count on it.~";
                   4: "~Yes, definitely.~";
                   5: "~Better not tell you now.~";
                   6: "~Outlook good.~";
               }
       ];
       ! The `];` above closes the before routine AND ends the object:
       ! `before` is its last property and there is no `has` line.

! ---------------------------------------------------------------------------
! ShakeSub — REQUIRED DEFAULT ROUTINE FOR THE SHAKE ACTION
!
! Every action used in a Verb declaration (Shake) must have a corresponding
! <Action>Sub routine (ShakeSub).  The library calls ShakeSub when the
! player shakes something OTHER than the 8-Ball — i.e., when no object's
! `before` handler intercepts the action.
!
! Without ShakeSub the compiler stops with an error ("No ...Sub action
! routine found for action") because the grammar table references the
! action but no handler routine exists.
!
! Every custom verb needs its action routine; the 8-Ball's `before` intercepts
! the interesting case, this is the fallback for shaking anything else.
! The whole routine fits on one line: header, one bare-string statement, `];`.
! ---------------------------------------------------------------------------
[ ShakeSub; "You give it a shake, but nothing happens."; ];

! ---------------------------------------------------------------------------
! CUSTOM VERB DECLARATION
!
! Verb 'shake' 'roll'
!   Two synonymous command words that trigger the same action.
!   Neither word is a PunyInform (or Standard Library) verb, so `Verb` is
!   right; to add a pattern to an existing verb you would use `Extend`,
!   placed after puny.h.
!
! * noun                  -> Shake
!   Grammar pattern: one required noun.  `-> Shake` routes to the Shake
!   action (calling ShakeSub, unless a `before` on the noun intercepts first,
!   as the 8-Ball's before handler does).
!
! In PunyInform, a Verb declaration for a brand-new word can appear before
! or after puny.h (the same is true in the Standard Library, before or after
! Include "Grammar"). This one sits after it.
! ---------------------------------------------------------------------------
Verb 'shake' 'roll'
    * noun                  -> Shake;

! ---------------------------------------------------------------------------
! INITIALISE ROUTINE (PunyInform)
! Runs once at startup, before the banner and before the library moves the
! player into INITIAL_LOCATION_VALUE. It must exist (the library calls it).
! `print` is used here; a bare string would print the same and return true,
! which changes nothing (only a return value of 2 matters: it hides the
! banner, in both libraries).
! ---------------------------------------------------------------------------
[ Initialise;
    print "^A Magic 8-Ball rests on a table. Try SHAKE BALL.^";
];
